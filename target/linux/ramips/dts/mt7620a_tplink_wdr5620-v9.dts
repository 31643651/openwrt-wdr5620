// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
//
// TP-Link TL-WDR5620 Gigabit Edition V9 ('OpenWrt custom' custom)
// SoC:   MT7620A   (2.4 GHz internal WMAC, eeprom @factory+0,   512B, magic 0x7620)
// 5 GHz: MT7663E   (PCIe ID 0x7663,      eeprom @factory+0x200, 1536B, magic 0x1234)
// Switch: RTL8367S-VB (RGMII to MT7620 GMAC, MDIO phy-id 29)
// Flash: 16 MB SPI NOR, original 0x0-0x20000 (u-boot + product info + caldata) untouched
//
// WARNING: keep the first 0x20000 bytes of flash identical to the factory image.

/dts-v1/;

#include "mt7620a.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "tplink,wdr5620-v9", "ralink,mt7620a-soc";
	model = "TP-Link TL-WDR5620 Gigabit Edition V9 (OpenWrt custom)";

	aliases {
		label-mac-device = &ethernet;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	rtl8367s {
		compatible = "realtek,rtl8367b";
		realtek,extif = <7 1 0 1 1 1 1 1 1 2>;
		mii-bus = <&mdio0>;
		phy-id = <29>;
	};
};

&state_default {
	gpio {
		groups = "i2c", "uartf", "ephy", "rgmii2";
		function = "gpio";
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <30000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x1f000>;
				read-only;
			};

			product_info: partition@1f000 {
				label = "product-info";
				reg = <0x1f000 0x800>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					// product info block starts with the 6-byte base MAC
					// (eth: +0, 2.4G: +1, 5G: +2)
					macaddr_info_0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			factory: partition@1f800 {
				label = "factory";
				reg = <0x1f800 0x800>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_wmac_2g: eeprom@0 {
						reg = <0x0 0x200>;
					};

					eeprom_wmac_5g: eeprom@200 {
						reg = <0x200 0x600>;
					};
				};
			};

			firmware: partition@20000 {
				compatible = "tplink,firmware";
				label = "firmware";
				reg = <0x20000 0xfe0000>;
			};
		};
	};
};

&ethernet {
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii1_pins &mdio_pins>;

	nvmem-cells = <&macaddr_info_0 0>;
	nvmem-cell-names = "mac-address";

	mediatek,portmap = "wllll";

	port@5 {
		status = "okay";
		phy-mode = "rgmii";
		mediatek,fixed-link = <1000 1 1 1>;
	};

	mdio0: mdio-bus {
		status = "okay";
	};
};

&pcie {
	status = "okay";
};

&pcie0 {
	wifi: mt76@0,0 {
		reg = <0x0000 0 0 0 0>;
		ieee80211-freq-limit = <5000000 6000000>;
	};
};

&wifi {
	nvmem-cells = <&eeprom_wmac_5g>, <&macaddr_info_0 2>;
	nvmem-cell-names = "eeprom", "mac-address";
};

&wmac {
	nvmem-cells = <&eeprom_wmac_2g>, <&macaddr_info_0 1>;
	nvmem-cell-names = "eeprom", "mac-address";
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};
